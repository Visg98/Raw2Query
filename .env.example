# Copy this file to .env and fill in real values. .env is git-ignored.

# Postgres connection used by both the API and worker processes.
# Matches the credentials in docker-compose.yml by default.
DATABASE_URL=postgresql+psycopg://raw2query:raw2query@localhost:5432/raw2query

# Restricted role used only to run LLM-generated NL-to-SQL queries - SELECT
# grants on the view_* views only, no base tables, no writes (plan section 3,
# call site 11's DB-enforced safety rail). Created by the initial Alembic
# migration; QUERY_RUNNER_DB_PASSWORD must be set before the first
# `alembic upgrade head` and match the password baked into this URL.
READONLY_DATABASE_URL=postgresql+psycopg://raw2query_query_runner:raw2query_query_runner@localhost:5432/raw2query
QUERY_RUNNER_DB_PASSWORD=raw2query_query_runner

# Gemini API key, from https://aistudio.google.com - used for every LLM call
# site (schema match, extraction, topic suggestion, query routing, NL-to-SQL
# generation, RAG composition). GEMINI_API_KEY is accepted as an alias, since
# that is the name the key arrives under.
#
# NOTE: Google's unpaid tier states that submitted content is used to improve
# Google products and that human reviewers may read it, and says outright:
# "Do not submit sensitive, confidential, or personal information to the
# Unpaid Services." This pipeline extracts invoices - vendors, addresses, bank
# details - so the free tier is only appropriate while the corpus is
# synthetic. See DEPLOY.md.
LLM_API_KEY=

# Gemini's OpenAI-compatible endpoint. The backend talks to it with the
# `openai` SDK; only override this to point at a proxy or another
# OpenAI-compatible provider.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Chat model used for the llm_classify / llm_extract helpers. Must support
# JSON-schema structured outputs with strict: true - the helpers parse the
# reply as JSON matching the schema they sent. Verified working:
# gemini-3.5-flash-lite, gemini-2.5-flash.
#
# flash-lite on purpose: the free tier meters *requests*, and the measured
# quota is 15/min for gemini-3.5-flash-lite against 5/min for
# gemini-2.5-flash - 3x the throughput for equal extraction accuracy on a
# 25-line invoice.
LLM_MODEL=gemini-3.5-flash-lite

# Requests-per-minute quota for the account this key belongs to. On Gemini's
# free tier this - not tokens - is what binds: measured at 15/min for
# flash-lite, read from the provider's own 429 payload. The pacer in
# app/pipeline/ratelimit.py keeps under it instead of letting calls 429 and
# fail the job, and adopts a corrected value if a 429 ever reports one.
#
# Check your account's real figure at https://ai.dev/rate-limit
LLM_REQUESTS_PER_MINUTE=15

# Only use this fraction of the quota, to cover the gap between our count and
# the provider's. Lower it if 429s still appear.
LLM_RATE_LIMIT_MARGIN=0.9

# Runaway guard on the reply length, deliberately generous. Do not tighten it
# to save tokens: with JSON-schema responses the provider returns *parseable*
# but incomplete JSON when it runs out of completion budget (a 25-row invoice
# came back as 21 rows, silently), so llm.py rejects any reply that hits this
# limit rather than storing a partial extraction.
LLM_MAX_COMPLETION_TOKENS=8192

# Document characters sent in one extraction call. Above this, extraction falls
# back to one call per chunk. Deliberately high: each chunk is a separate
# *request*, and requests are the metered resource, so a smaller value buys
# nothing and costs throughput.
MAX_EXTRACT_CHARS=40000

# Local embedding model for chunk vectors (decision #22). Must match the
# `vector(384)` dimension in the chunks table if changed.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Where uploaded originals are stored (decision: local filesystem for the prototype).
UPLOAD_DIR=./data/uploads

# Per-field confidence threshold below which a job is flagged for individual
# review instead of being eligible for "confirm all clean" (decision #13).
CONFIDENCE_THRESHOLD=0.75

# Worker poll loop interval, in seconds.
WORKER_POLL_INTERVAL_SECONDS=1.0

# Number of worker processes to run via `docker compose up --scale worker=N`.
#
# One by default, and that is a rate-limit decision, not a CPU one: the
# provider's request quota is per-key, but the pacer that respects it
# (app/pipeline/ratelimit.py) keeps its window in process memory. Two workers
# would each believe they had the whole 15 requests/min to themselves. Raise
# this only alongside LLM_REQUESTS_PER_MINUTE on a tier with real headroom.
WORKER_REPLICAS=1

# --- Public deployment only (see DEPLOY.md) -----------------------------------
# Both are read by docker-compose.prod.yml and only used by the Caddy service,
# so they can be left empty for local development.

# The hostname Caddy terminates TLS on, e.g. yourname.duckdns.org. Caddy asks
# Let's Encrypt for a certificate covering exactly this name.
DOMAIN=

# Shared token Caddy requires in the X-Demo-Token header. Must match the
# VITE_DEMO_TOKEN that Netlify builds into the frontend. Not authentication -
# it is public once inlined into the bundle - just a filter for crawlers and
# drive-by scanners. Generate one with: openssl rand -hex 24
DEMO_TOKEN=
